# Telegram API credentials from https://my.telegram.org (API development tools).
TG_API_ID=123456
TG_API_HASH=replace_with_api_hash

# Telethon session file. Relative paths resolve next to this file. Keep the
# generated .session file private; it is git-ignored.
TG_SESSION=rss_trigger

# Bot to send /check to.
BOT_USERNAME=MehranRSSReader_bot

# Poll interval in seconds for --loop mode (default 900 = 15 min).
INTERVAL_SECONDS=900
