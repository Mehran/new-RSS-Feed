{
  "name": "telegram-rss-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram RSS feed reader: commands on Telegram Serverless, polling and storage on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run deploy:worker && npm run deploy:tgcloud",
    "deploy:worker": "wrangler deploy",
    "deploy:tgcloud": "tgcloud push && tgcloud migrate --safe",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@tgcloud/cli": "^0.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.100.0"
  }
}
